<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="400dp"
    android:layout_height="800dp"
    android:layout_gravity="center"
    android:background="@android:color/transparent"
    android:backgroundTint="@android:color/transparent"
    android:backgroundTintMode="screen"
    android:layout_margin="20dp">

    <ImageView
        android:id="@+id/imgview_confetti"
        android:layout_width="248dp"
        android:layout_height="236dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/confetti" />

    <ImageView
        android:id="@+id/imgviewScoreBoard"
        android:layout_width="335dp"
        android:layout_height="415dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.518"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/quizresult_scoreboard_1star" />

    <TextView
        android:id="@+id/tvResult_Score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/chewy_regular"
        android:text="00"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="#FF2B2B2B"
        android:textSize="28sp"
        app:layout_constraintBottom_toBottomOf="@+id/imgviewScoreBoard"
        app:layout_constraintStart_toStartOf="@+id/tvResult_TimeTaken"
        app:layout_constraintTop_toTopOf="@+id/imgviewScoreBoard"
        app:layout_constraintVertical_bias="0.74" />

    <TextView
        android:id="@+id/tvResult_TimeTaken"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/chewy_regular"
        android:text="00"
        android:textColor="#2B2B2B"
        android:textSize="28sp"
        app:layout_constraintBottom_toBottomOf="@+id/imgviewScoreBoard"
        app:layout_constraintEnd_toEndOf="@+id/imgviewScoreBoard"
        app:layout_constraintHorizontal_bias="0.636"
        app:layout_constraintStart_toStartOf="@+id/imgviewScoreBoard"
        app:layout_constraintTop_toTopOf="@+id/imgviewScoreBoard"
        app:layout_constraintVertical_bias="0.633" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/imgviewScoreBoard"
        app:layout_constraintEnd_toEndOf="@+id/imgviewScoreBoard"
        app:layout_constraintStart_toStartOf="@+id/imgviewScoreBoard">

        <ImageButton
            android:id="@+id/imgbtnResult_Quit"
            android:layout_width="125dp"
            android:layout_height="60dp"
            android:backgroundTint="#00FFFFFF"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/newui_pause_quit"
            tools:srcCompat="@drawable/newui_pause_quit" />

        <ImageButton
            android:id="@+id/imgbtnResult_Again"
            android:layout_width="125dp"
            android:layout_height="60dp"
            android:backgroundTint="#00FFFFFF"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/gameresult_scoreboard_again_button"
            tools:srcCompat="@drawable/gameresult_scoreboard_again_button" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>