<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chart_letters_contraintlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NewUI_Chart_Letters">

    <ImageButton
        android:id="@+id/imgbtn_exit_chartletter"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#00FFFFFF"
        android:elevation="0dp"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/newui_back_button" />

    <TextView
        android:id="@+id/textView54"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/amasis_black"
        android:text="B20+ Chart"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/imgbtn_exit_chartletter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imgbtn_exit_chartletter" />

    <ImageView
        android:id="@+id/imgviewChart_empty"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@+id/imageView63"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgbtn_exit_chartletter"
        app:srcCompat="@drawable/chart_kudlit" />

    <ImageView
        android:id="@+id/imageView63"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="35dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/newui_chartletters_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/imageView63"
        app:layout_constraintEnd_toEndOf="@+id/imageView63"
        app:layout_constraintStart_toStartOf="@+id/imageView63"
        app:layout_constraintTop_toTopOf="@+id/imageView63">

        <ImageButton
            android:id="@+id/imgbtn_seeall"
            android:layout_width="150dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_marginEnd="5dp"
            android:backgroundTint="#00FFFFFF"
            android:paddingStart="10dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/newui_chartletters_menu" />

        <ImageButton
            android:id="@+id/imgbtn_previous"
            android:layout_width="70dp"
            android:layout_height="54dp"
            android:layout_gravity="center|right"
            android:backgroundTint="#00FFFFFF"
            android:rotation="180"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/newui_chartletters_arrow" />

        <ImageButton
            android:id="@+id/imgbtn_next"
            android:layout_width="70dp"
            android:layout_height="54dp"
            android:layout_gravity="center|right"
            android:layout_marginEnd="10dp"
            android:backgroundTint="#00FFFFFF"
            android:paddingEnd="5dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/newui_chartletters_arrow" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>