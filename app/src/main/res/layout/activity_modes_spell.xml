<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Modes_Spell">

    <ImageView
        android:id="@+id/imageView34"
        android:layout_width="0dp"
        android:layout_height="93dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="60dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/spell_header_board" />

    <ImageView
        android:id="@+id/imageView36"
        android:layout_width="310dp"
        android:layout_height="100dp"
        android:layout_marginTop="5dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_spell_remaining"
        app:srcCompat="@drawable/spell_long_board" />

    <TextView
        android:id="@+id/tv_spell_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/chewy_regular"
        android:text="ATTEMPTS REMAINING: 5"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@+id/imageView34"
        app:layout_constraintStart_toStartOf="@+id/imageView34"
        app:layout_constraintTop_toBottomOf="@+id/imageView34" />

    <TextView
        android:id="@+id/tv_spell_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/amasis_black"
        android:text="SALITA"
        android:textColor="#502F8A"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView36"
        app:layout_constraintEnd_toEndOf="@+id/imageView36"
        app:layout_constraintStart_toStartOf="@+id/imageView36"
        app:layout_constraintTop_toTopOf="@+id/imageView36" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginBottom="25dp"
        app:layout_constraintBottom_toBottomOf="@+id/spell_pause_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView36">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imageView46"
                android:layout_width="158dp"
                android:layout_height="39dp"
                app:layout_constraintBottom_toBottomOf="@+id/spell_choice1"
                app:layout_constraintEnd_toEndOf="@+id/spell_choice1"
                app:layout_constraintStart_toStartOf="@+id/spell_choice1"
                app:layout_constraintTop_toTopOf="@+id/spell_choice1"
                app:srcCompat="@drawable/spell_line_separators" />

            <ImageView
                android:id="@+id/imageView48"
                android:layout_width="158dp"
                android:layout_height="39dp"
                android:layout_marginTop="21dp"
                android:layout_marginBottom="18dp"
                app:layout_constraintBottom_toBottomOf="@+id/spell_choice2"
                app:layout_constraintEnd_toEndOf="@+id/spell_choice2"
                app:layout_constraintStart_toStartOf="@+id/spell_choice2"
                app:layout_constraintTop_toTopOf="@+id/spell_choice2"
                app:srcCompat="@drawable/spell_line_separators" />

            <ImageView
                android:id="@+id/imageView49"
                android:layout_width="158dp"
                android:layout_height="39dp"
                app:layout_constraintBottom_toBottomOf="@+id/spell_choice3"
                app:layout_constraintEnd_toEndOf="@+id/spell_choice3"
                app:layout_constraintStart_toStartOf="@+id/spell_choice3"
                app:layout_constraintTop_toTopOf="@+id/spell_choice3"
                app:srcCompat="@drawable/spell_line_separators" />

            <ImageView
                android:id="@+id/imageView50"
                android:layout_width="158dp"
                android:layout_height="39dp"
                app:layout_constraintBottom_toBottomOf="@+id/spell_choice4"
                app:layout_constraintEnd_toEndOf="@+id/spell_choice4"
                app:layout_constraintStart_toStartOf="@+id/spell_choice4"
                app:layout_constraintTop_toTopOf="@+id/spell_choice4"
                app:srcCompat="@drawable/spell_line_separators" />

            <ImageView
                android:id="@+id/imageView51"
                android:layout_width="158dp"
                android:layout_height="39dp"
                app:layout_constraintBottom_toBottomOf="@+id/spell_choice5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/spell_choice5"
                app:layout_constraintTop_toTopOf="@+id/spell_choice5"
                app:srcCompat="@drawable/spell_line_separators" />

            <ImageButton
                android:id="@+id/spell_choice1"
                android:layout_width="190dp"
                android:layout_height="78dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#00FFFFFF"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/spell_choices_btn" />

            <ImageButton
                android:id="@+id/spell_choice2"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#00FFFFFF"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="@+id/spell_choice1"
                app:layout_constraintStart_toStartOf="@+id/spell_choice1"
                app:layout_constraintTop_toBottomOf="@+id/spell_choice1"
                app:srcCompat="@drawable/spell_choices_btn" />

            <ImageButton
                android:id="@+id/spell_choice3"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#00FFFFFF"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="@+id/spell_choice2"
                app:layout_constraintStart_toStartOf="@+id/spell_choice2"
                app:layout_constraintTop_toBottomOf="@+id/spell_choice2"
                app:srcCompat="@drawable/spell_choices_btn" />

            <ImageButton
                android:id="@+id/spell_choice4"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#00FFFFFF"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="@+id/spell_choice3"
                app:layout_constraintStart_toStartOf="@+id/spell_choice3"
                app:layout_constraintTop_toBottomOf="@+id/spell_choice3"
                app:srcCompat="@drawable/spell_choices_btn" />

            <ImageButton
                android:id="@+id/spell_choice5"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#00FFFFFF"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="@+id/spell_choice4"
                app:layout_constraintStart_toStartOf="@+id/spell_choice4"
                app:layout_constraintTop_toBottomOf="@+id/spell_choice4"
                app:srcCompat="@drawable/spell_choices_btn" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageView
        android:id="@+id/imageView45"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="15dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/spell_square_small" />

    <ImageButton
        android:id="@+id/spell_pause_btn"
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="15dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/spell_pause_btn" />

    <TextView
        android:id="@+id/tv_spell_randomnumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/chewy_regular"
        android:text="5"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView45"
        app:layout_constraintEnd_toEndOf="@+id/imageView45"
        app:layout_constraintStart_toStartOf="@+id/imageView45"
        app:layout_constraintTop_toTopOf="@+id/imageView45" />

    <TextView
        android:id="@+id/tv_spell_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:fontFamily="@font/chewy_regular"
        android:text="00:00"
        android:textColor="#502F8A"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView34"
        app:layout_constraintEnd_toEndOf="@+id/imageView34"
        app:layout_constraintStart_toStartOf="@+id/imageView34"
        app:layout_constraintTop_toTopOf="@+id/imageView34" />

</androidx.constraintlayout.widget.ConstraintLayout>