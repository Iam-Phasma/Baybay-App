<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="250dp"
    android:layout_height="500dp"
    android:layout_gravity="center"
    android:backgroundTint="@android:color/transparent"
    android:backgroundTintMode="screen"
    android:layout_margin="20dp">

    <ImageButton
        android:id="@+id/img_history"
        android:layout_width="250dp"
        android:layout_height="87dp"
        android:layout_marginTop="100dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/guide_historybutton" />

    <ImageButton
        android:id="@+id/img_lessons"
        android:layout_width="0dp"
        android:layout_height="87dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="@+id/img_history"
        app:layout_constraintHorizontal_bias="0.508"
        app:layout_constraintStart_toStartOf="@+id/img_history"
        app:layout_constraintTop_toBottomOf="@+id/img_history"
        app:srcCompat="@drawable/guide_lessonsbutton_unlocked" />

    <ImageButton
        android:id="@+id/img_library"
        android:layout_width="0dp"
        android:layout_height="87dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="@+id/img_lessons"
        app:layout_constraintHorizontal_bias="0.508"
        app:layout_constraintStart_toStartOf="@+id/img_lessons"
        app:layout_constraintTop_toBottomOf="@+id/img_lessons"
        app:srcCompat="@drawable/guide_librarybutton_locked" />

    <ImageButton
        android:id="@+id/imgbtn_guideexit"
        android:layout_width="87dp"
        android:layout_height="76dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="@+id/img_library"
        app:layout_constraintStart_toStartOf="@+id/img_library"
        app:layout_constraintTop_toBottomOf="@+id/img_library"
        app:srcCompat="@drawable/btn_modes_back" />

    <TextView
        android:id="@+id/tv_history"
        android:layout_width="147dp"
        android:layout_height="35dp"
        android:fontFamily="@font/amasis_black"
        android:minLines="2"
        android:text="The History of Baybayin Script"
        android:textAlignment="center"
        android:textColor="#454545"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/img_history"
        app:layout_constraintEnd_toEndOf="@+id/img_history"
        app:layout_constraintHorizontal_bias="0.796"
        app:layout_constraintStart_toStartOf="@+id/img_history"
        app:layout_constraintTop_toTopOf="@+id/img_history"
        app:layout_constraintVertical_bias="0.576" />

    <TextView
        android:id="@+id/tv_lessons"
        android:layout_width="120dp"
        android:layout_height="34dp"
        android:fontFamily="@font/amasis_black"
        android:minLines="2"
        android:text="Reading and Writing Lessons"
        android:textAlignment="center"
        android:textColor="#454545"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/img_lessons"
        app:layout_constraintEnd_toEndOf="@+id/img_lessons"
        app:layout_constraintHorizontal_bias="0.292"
        app:layout_constraintStart_toStartOf="@+id/img_lessons"
        app:layout_constraintTop_toTopOf="@+id/img_lessons"
        app:layout_constraintVertical_bias="0.471" />

    <TextView
        android:id="@+id/tv_library"
        android:layout_width="113dp"
        android:layout_height="35dp"
        android:fontFamily="@font/amasis_black"
        android:minLines="2"
        android:text="Library of Reading Materials"
        android:textAlignment="center"
        android:textColor="#454545"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/img_library"
        app:layout_constraintEnd_toEndOf="@+id/img_library"
        app:layout_constraintHorizontal_bias="0.689"
        app:layout_constraintStart_toStartOf="@+id/img_library"
        app:layout_constraintTop_toTopOf="@+id/img_library" />
</androidx.constraintlayout.widget.ConstraintLayout>