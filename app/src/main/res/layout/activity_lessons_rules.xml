<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NewUI_L4_Rules">

    <ImageButton
        android:id="@+id/btn_rules_exit"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#00DA4848"
        android:fontFamily="@font/sans_serif_bold"
        android:scaleType="fitCenter"
        android:src="@drawable/newui_back_button"
        android:text="EXIT"
        android:textColor="#FFFFFF"
        app:cornerRadius="100dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rippleColor="#6BFFFFFF"
        tools:src="@drawable/newui_back_button" />

    <TextView
        android:id="@+id/textView86"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/amasis_black"
        android:text="Rules"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_rules_exit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_rules_exit" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_rules_exit">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgview_rulesboard"
                android:layout_width="0dp"
                android:layout_height="485dp"
                android:layout_marginStart="17dp"
                android:layout_marginEnd="17dp"
                android:scaleType="fitXY"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/rules_kudlit_2a" />

            <Button
                android:id="@+id/btn_rules_previous"
                android:layout_width="120dp"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:backgroundTint="#57CD5C"
                android:fontFamily="@font/sans_serif_bold"
                android:text="PREV"
                android:textColor="#FFFFFF"
                app:cornerRadius="8dp"
                app:layout_constraintStart_toStartOf="@+id/imgview_rulesboard"
                app:layout_constraintTop_toBottomOf="@+id/imgview_rulesboard"
                app:rippleColor="#6BFFFFFF"
                app:strokeColor="#000000"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btn_rules_next"
                android:layout_width="120dp"
                android:layout_height="0dp"
                android:layout_marginEnd="20dp"
                android:backgroundTint="#57CD5C"
                android:fontFamily="@font/sans_serif_bold"
                android:text="NEXT"
                android:textColor="#FFFFFF"
                app:cornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="@+id/imgview_rulesboard"
                app:layout_constraintTop_toBottomOf="@+id/imgview_rulesboard"
                app:rippleColor="#6BFFFFFF"
                app:strokeColor="#000000"
                app:strokeWidth="2dp" />

            <TextView
                android:id="@+id/textView87"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="50dp"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:text="Let's practice some words"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/imgview_rulesboard"
                app:layout_constraintTop_toBottomOf="@+id/btn_rules_previous" />

            <TextView
                android:id="@+id/textView88"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:text="Translate the word in baybayin into tagalog"
                android:textColor="#000000"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@+id/textView87"
                app:layout_constraintTop_toBottomOf="@+id/textView87" />

            <TextView
                android:id="@+id/textView89"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:text="Word:"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/imgview_rulesboard"
                app:layout_constraintTop_toBottomOf="@+id/textView88" />

            <ImageView
                android:id="@+id/imgview_practice_question"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                app:layout_constraintBottom_toBottomOf="@+id/textView89"
                app:layout_constraintStart_toEndOf="@+id/textView89"
                app:layout_constraintTop_toTopOf="@+id/textView89"
                app:srcCompat="@drawable/newui_tr_araw" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:hint="Answer"
                android:paddingBottom="10dp"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="#050505"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="#000000"
                app:layout_constraintEnd_toEndOf="@+id/imgview_rulesboard"
                app:layout_constraintStart_toStartOf="@+id/textView89"
                app:layout_constraintTop_toBottomOf="@+id/textView89">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edittext_practiceanswer"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:inputType="text|textCapWords"
                    android:maxLength="10"
                    android:textColor="#000000"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_rules_practice_submit"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="50dp"
                android:backgroundTint="#00BCD4"
                android:fontFamily="@font/sans_serif_bold"
                android:text="Submit"
                android:textColor="#FFFFFF"
                app:cornerRadius="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/textInputLayout"
                app:layout_constraintStart_toStartOf="@+id/textInputLayout"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout"
                app:rippleColor="#6BFFFFFF"
                app:strokeColor="#000000"
                app:strokeWidth="2dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>