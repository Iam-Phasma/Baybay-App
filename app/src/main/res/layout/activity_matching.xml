    </androidx.core.widget.NestedScrollView>

    <ImageButton
        android:id="@+id/imageButton9"
        android:layout_width="251dp"
        android:layout_height="112dp"
        android:layout_marginBottom="30dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/match_picker_board" />

    <ImageButton
        android:id="@+id/imgbtn_pass"
        android:layout_width="65dp"
        android:layout_height="60dp"
        android:layout_marginEnd="50dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/imageButton9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageButton9"
        app:srcCompat="@drawable/newui_chartletters_arrow"
        tools:srcCompat="@drawable/newui_chartletters_arrow" />

    <TextView
        android:id="@+id/tv_match_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="NGA"
        android:textColor="#FFC107"
        android:textSize="34sp"
        app:layout_constraintBottom_toBottomOf="@+id/imageButton9"
        app:layout_constraintEnd_toEndOf="@+id/imageButton9"
        app:layout_constraintStart_toStartOf="@+id/imageButton9"
        app:layout_constraintTop_toTopOf="@+id/imageButton9"
        app:layout_constraintVertical_bias="0.55" />

    <TextView
        android:id="@+id/tv_match_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="55dp"
        android:fontFamily="sans-serif-black"
        android:text="ba"
        android:textColor="#CFCFCF"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_match_current"
        app:layout_constraintEnd_toEndOf="@+id/imageButton9"
        app:layout_constraintTop_toTopOf="@+id/tv_match_current"
        app:layout_constraintVertical_bias="0.55" />

    <TextView
        android:id="@+id/tv_match_previous"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="55dp"
        android:fontFamily="sans-serif-black"
        android:text="ba"
        android:textColor="#CFCFCF"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_match_current"
