<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constarintlayout_newsettings"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="15dp"
    android:background="@drawable/dialog_bg">

    <ImageButton
        android:id="@+id/cb_BackgroundNew"
        android:layout_width="66dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="@+id/textView"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:srcCompat="@drawable/cb_soundoff" />

    <ImageButton
        android:id="@+id/rb_woodland_fantacy"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toEndOf="@+id/cb_BackgroundNew"
        app:layout_constraintTop_toBottomOf="@+id/textView7"
        app:srcCompat="@drawable/newui_settings_radiobutton_on" />

    <ImageButton
        android:id="@+id/rb_curious_critters"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginTop="-5dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="@+id/rb_woodland_fantacy"
        app:layout_constraintStart_toStartOf="@+id/rb_woodland_fantacy"
        app:layout_constraintTop_toBottomOf="@+id/rb_woodland_fantacy"
        app:srcCompat="@drawable/newui_settings_radiobutton_off" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="144dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:lineSpacingExtra="0dp"
        android:text="Background Music"
        android:textColor="#323232"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/cb_BackgroundNew"
        app:layout_constraintStart_toEndOf="@+id/cb_BackgroundNew"
        app:layout_constraintTop_toTopOf="@+id/cb_BackgroundNew" />

    <TextView
        android:id="@+id/tv_woodlandfantasy"
        android:layout_width="144dp"
        android:layout_height="35dp"
        android:fontFamily="sans-serif-light"
        android:gravity="center_vertical"
        android:lineSpacingExtra="0dp"
        android:text="Woodland Fantasy"
        android:textColor="#323232"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/rb_woodland_fantacy"
        app:layout_constraintStart_toEndOf="@+id/rb_woodland_fantacy"
        app:layout_constraintTop_toTopOf="@+id/rb_woodland_fantacy" />

    <TextView
        android:id="@+id/tv_curiouscritters"
        android:layout_width="144dp"
        android:layout_height="35dp"
        android:fontFamily="sans-serif-light"
        android:gravity="center_vertical"
        android:lineSpacingExtra="0dp"
        android:text="Curious Critters"
        android:textColor="#323232"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/rb_curious_critters"
        app:layout_constraintStart_toEndOf="@+id/rb_curious_critters"
        app:layout_constraintTop_toTopOf="@+id/rb_curious_critters" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="144dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:lineSpacingExtra="0dp"
        android:text="Sound Effects"
        android:textColor="#323232"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/cb_SEffectsNew"
        app:layout_constraintStart_toEndOf="@+id/cb_BackgroundNew"
        app:layout_constraintTop_toTopOf="@+id/cb_SEffectsNew" />

    <ImageButton
        android:id="@+id/cb_SEffectsNew"
        android:layout_width="66dp"
        android:layout_height="60dp"
        android:layout_marginTop="-10dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="@+id/textView"
        app:layout_constraintTop_toBottomOf="@+id/rb_curious_critters"
        app:srcCompat="@drawable/cb_soundoff" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="241dp"
        android:layout_height="57dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="35dp"
        android:fontFamily="sans-serif-black"
        android:maxLines="2"
        android:text="Manage and Personalize your space"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="256dp"
        android:layout_height="27dp"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-black"
        android:maxLines="2"
        android:text="Theme Color"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/cb_SEffectsNew"
        app:layout_constraintTop_toBottomOf="@+id/cb_SEffectsNew" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="70dp"
        android:layout_height="12dp"
        android:layout_marginTop="10dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/newui_settings_yellowtab" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView11">

        <ImageButton
            android:id="@+id/rb_latte"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:backgroundTint="#00FFFFFF"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/newui_settings_radiobutton_on" />

        <TextView
            android:id="@+id/textView12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:lineSpacingExtra="0dp"
            android:text="Latte"
            android:textColor="#323232"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/rb_alice"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="30dp"
            android:backgroundTint="#00FFFFFF"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/newui_settings_radiobutton_off" />

        <TextView
            android:id="@+id/tv_alice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:lineSpacingExtra="0dp"
            android:text="Alice"
            android:textColor="#323232"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="0dp"
        android:layout_height="15dp"
        android:layout_marginStart="-5dp"
        android:layout_marginEnd="-5dp"
        android:alpha="1"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"
        app:srcCompat="@drawable/newui_settings_dashes" />

    <TextView
        android:id="@+id/tv_appversion2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:elevation="20dp"
        android:fontFamily="sans-serif-medium"
        android:text="Version"
        android:textColor="#454545"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView4" />

    <ImageButton
        android:id="@+id/btn_feedback"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="@+id/tv_appversion2"
        app:layout_constraintStart_toStartOf="@+id/tv_appversion2"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
        app:srcCompat="@drawable/newui_settings_feedback" />

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_appversion2">

        <ImageButton
            android:id="@+id/btn_checkupdate"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:backgroundTint="#00FFFFFF"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/newui_settings_updatecheck" />

        <ImageButton
            android:id="@+id/btn_attribution"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:backgroundTint="#00FFFFFF"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/newui_settings_attribution" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>