<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraint_drawinguideprompt"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:layout_margin="20dp"
    android:backgroundTint="@android:color/transparent"
    android:backgroundTintMode="screen" >

    <LinearLayout
        android:id="@+id/linearlayout_drawinguideprompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_corners"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_drawinguidetittle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="50dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="A"
            android:textAlignment="textStart"
            android:textColor="#121212"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_drawinguideprompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="50dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="TextView"
            android:textAlignment="textStart"
            android:textColor="#121212"
            android:textSize="16sp" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/imgbtn_writing_prompt_ok"
        android:layout_width="130dp"
        android:layout_height="60dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="fitXY"
        android:layout_marginTop="30dp"
        android:src="@drawable/newui_dl_link_promt_ok"
        app:layout_constraintEnd_toEndOf="@+id/linearlayout_drawinguideprompt"
        app:layout_constraintStart_toStartOf="@+id/linearlayout_drawinguideprompt"
        app:layout_constraintTop_toBottomOf="@+id/linearlayout_drawinguideprompt"
        tools:src="@drawable/newui_dl_link_promt_ok" />

</androidx.constraintlayout.widget.ConstraintLayout>