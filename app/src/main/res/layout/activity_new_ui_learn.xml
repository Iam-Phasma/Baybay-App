                        android:layout_height="60dp"
                        android:layout_gravity="right"
                        android:backgroundTint="#00FFFFFF"
                        android:scaleType="fitCenter"
                        android:src="@drawable/newui_lesson2_sub4"
                        tools:src="@drawable/newui_lesson2_sub4" />

                    <ImageButton
                        android:id="@+id/hidden2Button5"
