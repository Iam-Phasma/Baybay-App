                    android:layout_height="120dp"
                    android:backgroundTint="#00FFFFFF"
                    android:scaleType="fitCenter"
                    android:src="@drawable/newui_lesson2_unsel"
                    tools:src="@drawable/newui_lesson2_unsel" />

